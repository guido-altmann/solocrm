@inject NavigationManager Navigation

@* Links to the statically rendered account pages (SPEC 3.3 S6); they need a full page load. *@
<MudPaper Outlined="true" Class="pa-4" Style="max-width: 800px;">
    <MudText Typo="Typo.h6">Konto</MudText>
    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
        Passwort, Zwei-Faktor-Anmeldung mit Authenticator-App und Passkeys des Benutzerkontos.
    </MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Password"
                   OnClick="@(() => Open("Account/Manage/ChangePassword"))" data-testid="account-change-password">
            Passwort ändern
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PhonelinkLock"
                   OnClick="@(() => Open("Account/Manage/TwoFactorAuthentication"))" data-testid="account-2fa">
            Zwei-Faktor-Anmeldung
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Key"
                   OnClick="@(() => Open("Account/Manage/Passkeys"))" data-testid="account-passkeys">
            Passkeys
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    private void Open(string path) => Navigation.NavigateTo(path, forceLoad: true);
}
