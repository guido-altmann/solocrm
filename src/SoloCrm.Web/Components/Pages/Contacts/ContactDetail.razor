@page "/contacts/{Id:guid}"
@using SoloCrm.Application.Abstractions
@using SoloCrm.Application.Features.Contacts
@using SoloCrm.Application.Features.Opportunities
@using SoloCrm.Application.Features.Timeline
@using SoloCrm.Domain.Common
@using SoloCrm.Domain.Contacts
@implements IDisposable
@inject IQueryHandler<GetContact.Query, GetContact.Result> GetContactHandler
@inject ICommandHandler<UpdateContact.Command, UpdateContact.Result> UpdateContactHandler
@inject IQueryHandler<GetRelatedOpportunities.Query, GetRelatedOpportunities.Result> GetOpportunitiesHandler
@inject QuickAddService QuickAdd

<PageTitle>@(_contact is null ? "Kontakt" : Name) · SoloCRM</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">Der Kontakt wurde nicht gefunden.</MudAlert>
}
else if (_contact is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" md="4">
            <MudStack Spacing="4">
                <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.h5">@Name</MudText>
                    @if (_contact.JobTitle is not null)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@_contact.JobTitle</MudText>
                    }
                    @if (_contact.IsArchived)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-0">Archiviert</MudChip>
                    }
                    @* Master data are edited inline (US-14); each change is saved with all current values. *@
                    <MudStack Spacing="1" Class="mt-3">
                        <InlineText Label="Vorname" Field="@nameof(IContactFields.FirstName)" Value="@_contact.FirstName"
                                    MaxLength="@Contact.FirstNameMaxLength" Save="@(v => SaveAsync(c => c with { FirstName = v }))" />
                        <InlineText Label="Nachname" Field="@nameof(IContactFields.LastName)" Value="@_contact.LastName"
                                    MaxLength="@Contact.LastNameMaxLength" Save="@(v => SaveAsync(c => c with { LastName = v }))" />
                        <InlineField Label="Organisation" Field="@nameof(IContactFields.OrganizationId)" IsEmpty="_contact.OrganizationId is null"
                                     OnBeginEdit="BeginOrganizationEdit" Save="SaveOrganizationAsync" SaveKey="InlineSaveKey.None" ShowCancel="true">
                            <Display>
                                <span @onclick:stopPropagation="true">
                                    <MudLink Href="@Links.Organization(_contact.OrganizationId!.Value)">@_contact.OrganizationName</MudLink>
                                </span>
                            </Display>
                            <Editor>
                                <OrganizationAutocomplete Value="_organizationDraft" ValueChanged="o => ChooseOrganizationAsync(context, o)"
                                                          Label="" AllowCreate="true" AutoFocus="true" Margin="Margin.Dense"
                                                          Error="context.HasError" />
                            </Editor>
                        </InlineField>
                        <InlineText Label="E-Mail" Field="@nameof(IContactFields.Email)" Value="@_contact.Email" InputType="InputType.Email"
                                    MaxLength="@Contact.EmailMaxLength" Save="@(v => SaveAsync(c => c with { Email = v }))">
                            <DisplayTemplate>
                                <span @onclick:stopPropagation="true"><MudLink Href="@($"mailto:{context}")">@context</MudLink></span>
                            </DisplayTemplate>
                        </InlineText>
                        <InlineText Label="Telefon" Field="@nameof(IContactFields.Phone)" Value="@_contact.Phone" InputType="InputType.Telephone"
                                    MaxLength="@Contact.PhoneMaxLength" Save="@(v => SaveAsync(c => c with { Phone = v }))">
                            <DisplayTemplate>
                                <span @onclick:stopPropagation="true"><MudLink Href="@($"tel:{context}")">@context</MudLink></span>
                            </DisplayTemplate>
                        </InlineText>
                        <InlineText Label="Rolle" Field="@nameof(IContactFields.JobTitle)" Value="@_contact.JobTitle" Placeholder="z. B. Recruiterin, CTO"
                                    MaxLength="@Contact.JobTitleMaxLength" Save="@(v => SaveAsync(c => c with { JobTitle = v }))" />
                        <InlineText Label="LinkedIn" Field="@nameof(IContactFields.LinkedInUrl)" Value="@_contact.LinkedInUrl" InputType="InputType.Url"
                                    MaxLength="@Contact.LinkedInUrlMaxLength" Save="@(v => SaveAsync(c => c with { LinkedInUrl = v }))">
                            <DisplayTemplate>
                                <span @onclick:stopPropagation="true">
                                    <MudLink Href="@context" Target="_blank" rel="noopener noreferrer">Profil öffnen</MudLink>
                                </span>
                            </DisplayTemplate>
                        </InlineText>
                        <InlineSelect T="LeadSource?" Label="Quelle" Field="@nameof(IContactFields.Source)" Value="_contact.Source"
                                      Options="Sources" TextOf="s => Labels.For(s!.Value)" Clearable="true"
                                      Save="@(v => SaveAsync(c => c with { Source = v }))" />
                        <InlineAddress Value="_contact.Address" Save="@(a => SaveAsync(c => c with { Address = a }))" />
                    </MudStack>
                </MudPaper>

                <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Tags</MudText>
                    <TagInput RecordType="TimelineRecordType.Contact" RecordId="Id" />
                </MudPaper>

                <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-1">Anfragen</MudText>
                    <RelatedOpportunityList Items="_opportunities" />
                </MudPaper>

                <OpenTasksCard LinkedTo="_linkedTo" OnChanged="ReloadTimelineAsync" />
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudPaper Outlined="true" Class="pa-4">
                <Timeline @ref="_timeline" RecordType="TimelineRecordType.Contact" RecordId="Id" LinkedTo="_linkedTo" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private static readonly LeadSource?[] Sources = [.. Enum.GetValues<LeadSource>().Cast<LeadSource?>()];

    private GetContact.Result? _contact;
    private OrganizationOption? _organizationDraft;
    private IReadOnlyList<GetRelatedOpportunities.Item> _opportunities = [];
    private LinkedRecords _linkedTo = LinkedRecords.None;
    private List<BreadcrumbItem> _breadcrumbs = [];
    private Timeline? _timeline;
    private IDisposable? _noteInput;
    private bool _notFound;

    private string Name => Names.Person(_contact?.FirstName, _contact?.LastName);

    protected override void OnInitialized() =>
        _noteInput = QuickAdd.RegisterNoteInput(() => _timeline?.FocusInputAsync() ?? Task.CompletedTask);

    protected override async Task OnParametersSetAsync()
    {
        _linkedTo = new LinkedRecords(ContactId: Id);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var contact = await GetContactHandler.Handle(new GetContact.Query(Id), CancellationToken.None);
        _notFound = contact.IsFailure;
        if (contact.IsFailure)
        {
            return;
        }

        _contact = contact.Value;
        _breadcrumbs = [new("Kontakte", "/contacts"), new(Name, null, disabled: true)];

        var opportunities = await GetOpportunitiesHandler.Handle(new GetRelatedOpportunities.Query(PrimaryContactId: Id), CancellationToken.None);
        _opportunities = opportunities.IsSuccess ? opportunities.Value.Items : [];
    }

    /// <summary>Saves one changed field together with all current values (iteration 4 decision 2).</summary>
    private async Task<Error?> SaveAsync(Func<UpdateContact.Command, UpdateContact.Command> change)
    {
        var c = _contact!;
        var command = change(new UpdateContact.Command(
            c.Id, c.FirstName, c.LastName, c.Email, c.Phone, c.JobTitle, c.LinkedInUrl, c.OrganizationId, null, c.Source, c.Address));
        var result = await UpdateContactHandler.Handle(command, CancellationToken.None);
        if (result.IsFailure)
        {
            return result.Error;
        }

        await LoadAsync();
        await ReloadTimelineAsync();

        // The save is triggered by an event of the field, so this page does not re-render on its own.
        StateHasChanged();
        return null;
    }

    private void BeginOrganizationEdit() =>
        _organizationDraft = OrganizationOption.Existing(_contact!.OrganizationId, _contact.OrganizationName, _contact.OrganizationType);

    private async Task ChooseOrganizationAsync(InlineField field, OrganizationOption? organization)
    {
        _organizationDraft = organization;
        await field.SaveAsync();
    }

    /// <summary>An existing organization, a new one created inline (US-02 AK2), or none.</summary>
    private Task<Error?> SaveOrganizationAsync()
    {
        if (_organizationDraft?.Id == _contact!.OrganizationId && _organizationDraft?.IsNew != true)
        {
            return Task.FromResult<Error?>(null);
        }

        var (id, newName) = OrganizationOption.ToCommand(_organizationDraft);
        return SaveAsync(c => c with { OrganizationId = id, NewOrganizationName = newName });
    }

    private Task ReloadTimelineAsync() => _timeline?.ReloadAsync() ?? Task.CompletedTask;

    public void Dispose() => _noteInput?.Dispose();
}
