@page "/Account/Manage/ResetAuthenticator"

@using Microsoft.AspNetCore.Identity
@using SoloCrm.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject FactorChanges FactorChanges

<PageTitle>Schlüssel zurücksetzen · SoloCRM</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Schlüssel der Authenticator-App zurücksetzen</MudText>
<StatusMessage />
<MudAlert Severity="Severity.Warning" Class="mb-4">
    Der bisherige Eintrag in der App funktioniert danach nicht mehr, und die Zwei-Faktor-Anmeldung ist deaktiviert,
    bis du die App mit dem neuen Schlüssel eingerichtet hast.
</MudAlert>
<form @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post">
    <AntiforgeryToken />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Error">Schlüssel zurücksetzen</MudButton>
    <MudButton Href="Account/Manage/TwoFactorAuthentication" Variant="Variant.Text" Class="ml-2">Abbrechen</MudButton>
</form>

@code {
    private ApplicationUser? user;
    private bool confirmed;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        confirmed = FactorChanges.EnsureConfirmed(HttpContext, user);
    }

    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (!confirmed)
        {
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(user, false);
        await UserManager.ResetAuthenticatorKeyAsync(user);
        await FactorChanges.CompleteAsync(user, "authenticator key reset");

        RedirectManager.RedirectToWithStatus(
            "Account/Manage/EnableAuthenticator",
            "Der Schlüssel wurde zurückgesetzt. Richte die Authenticator-App mit dem neuen Schlüssel ein.",
            HttpContext);
    }
}
