@page "/Account/Manage"

@using Microsoft.AspNetCore.Identity
@using SoloCrm.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Konto · SoloCRM</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Übersicht</MudText>
<StatusMessage />

<MudSimpleTable Dense="true" Elevation="0" Class="mb-4">
    <tbody>
        <tr>
            <th scope="row">Angemeldet als</th>
            <td data-testid="account-name">@userName</td>
        </tr>
        <tr>
            <th scope="row">Zwei-Faktor-Anmeldung</th>
            <td data-testid="account-2fa">@(is2faEnabled ? "aktiv" : "nicht aktiv")</td>
        </tr>
        <tr>
            <th scope="row">Passkeys</th>
            <td>@(passkeyCount == 1 ? "1 Passkey" : $"{passkeyCount} Passkeys")</td>
        </tr>
    </tbody>
</MudSimpleTable>

<MudText Typo="Typo.body2" Class="mud-text-secondary">
    Die E-Mail-Adresse des Kontos kommt aus der Konfiguration (<code>Admin__Email</code>) und wird hier nicht geändert.
</MudText>

@code {
    private string? userName;
    private bool is2faEnabled;
    private int passkeyCount;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        userName = await UserManager.GetUserNameAsync(user);
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        passkeyCount = (await UserManager.GetPasskeysAsync(user)).Count;
    }
}
