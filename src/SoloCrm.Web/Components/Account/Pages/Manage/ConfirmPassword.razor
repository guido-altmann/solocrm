@page "/Account/Manage/ConfirmPassword"
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting(SoloCrm.Web.Hosting.LoginRateLimiting.PolicyName)]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using SoloCrm.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject FactorChanges FactorChanges
@inject ILogger<ConfirmPassword> Logger

@* Asks for the password before sign-in factors are changed (SOL-34, FactorChanges). *@
<PageTitle>Passwort bestätigen · SoloCRM</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">Passwort bestätigen</MudText>
<StatusMessage Message="@message" />
<MudText Typo="Typo.body2" Class="mb-4">
    Änderungen an Passkeys und an der Zwei-Faktor-Anmeldung erfordern dein Passwort. Danach kannst du
    @((int)FactorChanges.Window.TotalMinutes) Minuten lang ohne erneute Abfrage weitere Änderungen vornehmen.
</MudText>
<EditForm Model="Input" FormName="confirm-password" OnValidSubmit="OnValidSubmitAsync" method="post" style="max-width: 420px;">
    <DataAnnotationsValidator />
    <AccountField Label="Passwort" For="Input.Password" Validation="() => Input.Password">
        <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="account-input" autocomplete="current-password" aria-required="true" />
    </AccountField>
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Bestätigen</MudButton>
    <MudButton Href="Account/Manage" Variant="Variant.Text" Class="ml-2">Abbrechen</MudButton>
</EditForm>

@code {
    private string? message;
    private ApplicationUser? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    // The form posts to the current URL, so the query is also present on submit.
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        // Failures count towards the lockout like at sign-in (SOL-30, AccountSecurity).
        var result = await SignInManager.CheckPasswordSignInAsync(user, Input.Password, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            FactorChanges.Confirm(HttpContext, user);
            RedirectManager.RedirectTo(FactorChanges.SafeReturnUrl(ReturnUrl));
            return;
        }

        if (result.IsLockedOut)
        {
            Logger.LogWarning("User account locked out.");
            message = $"{StatusMessage.ErrorPrefix}Zu viele Fehlversuche. Das Konto ist vorübergehend gesperrt.";
            return;
        }

        Logger.LogWarning("Failed password confirmation.");
        message = $"{StatusMessage.ErrorPrefix}Das Passwort ist falsch.";
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Bitte das Passwort angeben.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
