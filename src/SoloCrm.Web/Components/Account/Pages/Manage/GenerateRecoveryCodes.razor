@page "/Account/Manage/GenerateRecoveryCodes"

@using Microsoft.AspNetCore.Identity
@using SoloCrm.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject FactorChanges FactorChanges

<PageTitle>Neue Wiederherstellungscodes · SoloCRM</PageTitle>

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <MudText Typo="Typo.h5" Class="mb-4">Neue Wiederherstellungscodes</MudText>
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Die bisherigen Codes werden ungültig. Die Authenticator-App bleibt eingerichtet; um ihren Schlüssel zu ersetzen,
        <MudLink Href="Account/Manage/ResetAuthenticator">setze den Schlüssel zurück</MudLink>.
    </MudAlert>
    <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Codes erzeugen</MudButton>
        <MudButton Href="Account/Manage/TwoFactorAuthentication" Variant="Variant.Text" Class="ml-2">Abbrechen</MudButton>
    </form>
}

@code {
    private string? message;
    private ApplicationUser? user;
    private bool confirmed;
    private IEnumerable<string>? recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        confirmed = FactorChanges.EnsureConfirmed(HttpContext, user);
        if (!confirmed)
        {
            return;
        }

        if (!await UserManager.GetTwoFactorEnabledAsync(user))
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Manage/TwoFactorAuthentication", $"{StatusMessage.ErrorPrefix}Die Zwei-Faktor-Anmeldung ist nicht aktiv.", HttpContext);
        }
    }

    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (!confirmed)
        {
            return;
        }

        recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
        message = "Neue Wiederherstellungscodes erzeugt.";

        await FactorChanges.CompleteAsync(user, "recovery codes regenerated");
    }
}
