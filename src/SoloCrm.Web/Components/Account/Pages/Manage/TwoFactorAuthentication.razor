@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Identity
@using SoloCrm.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Zwei-Faktor-Anmeldung · SoloCRM</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">Zwei-Faktor-Anmeldung</MudText>
<StatusMessage />
<MudText Typo="Typo.body2" Class="mb-4">
    Mit einer Authenticator-App (z. B. Aegis, 2FAS, Microsoft oder Google Authenticator) fragt die Anmeldung zusätzlich
    zum Passwort einen sechsstelligen Code ab. Sie ist optional, aber empfohlen.
</MudText>

@if (is2faEnabled)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4" data-testid="2fa-status">Die Zwei-Faktor-Anmeldung ist aktiv.</MudAlert>

    @if (recoveryCodesLeft <= 3)
    {
        <MudAlert Severity="@(recoveryCodesLeft <= 1 ? Severity.Error : Severity.Warning)" Dense="true" Class="mb-4">
            @(recoveryCodesLeft switch
            {
                0 => "Es sind keine Wiederherstellungscodes mehr übrig.",
                1 => "Es ist nur noch 1 Wiederherstellungscode übrig.",
                _ => $"Es sind nur noch {recoveryCodesLeft} Wiederherstellungscodes übrig.",
            })
            Erzeuge neue Codes, damit du dich auch ohne App anmelden kannst.
        </MudAlert>
    }

    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-6">
        <MudButton Href="Account/Manage/GenerateRecoveryCodes" Variant="Variant.Outlined" Color="Color.Primary">Neue Wiederherstellungscodes</MudButton>
        @if (isMachineRemembered)
        {
            <form @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary">Diesen Browser vergessen</MudButton>
            </form>
        }
        <MudButton Href="Account/Manage/Disable2fa" Variant="Variant.Outlined" Color="Color.Error">Zwei-Faktor-Anmeldung deaktivieren</MudButton>
    </MudStack>
}
else
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" data-testid="2fa-status">Die Zwei-Faktor-Anmeldung ist nicht aktiv.</MudAlert>
}

<MudText Typo="Typo.h6" Class="mb-2">Authenticator-App</MudText>
<MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
    @if (!hasAuthenticator || !is2faEnabled)
    {
        <MudButton Href="Account/Manage/EnableAuthenticator" Variant="Variant.Filled" Color="Color.Primary">Authenticator-App einrichten</MudButton>
    }
    else
    {
        <MudButton Href="Account/Manage/EnableAuthenticator" Variant="Variant.Outlined" Color="Color.Primary">Weitere App einrichten</MudButton>
    }
    @if (hasAuthenticator)
    {
        <MudButton Href="Account/Manage/ResetAuthenticator" Variant="Variant.Outlined" Color="Color.Error">Schlüssel zurücksetzen</MudButton>
    }
</MudStack>

@code {
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "Dieser Browser wurde vergessen. Bei der nächsten Anmeldung wird wieder ein Code abgefragt.",
            HttpContext);
    }
}
