<StatusMessage Message="@StatusMessage" />
<MudText Typo="Typo.h5" Class="mb-2">Wiederherstellungscodes</MudText>
<MudAlert Severity="Severity.Warning" Class="mb-4">
    <strong>Bewahre diese Codes an einem sicheren Ort auf.</strong>
    Jeder Code funktioniert genau einmal. Ohne Authenticator-App und ohne Wiederherstellungscode ist keine Anmeldung mehr möglich.
</MudAlert>
<div class="recovery-codes" data-testid="recovery-codes">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <code class="recovery-code">@recoveryCode</code>
    }
</div>
<MudButton Href="Account/Manage/TwoFactorAuthentication" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Fertig</MudButton>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
