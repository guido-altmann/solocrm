@if (!string.IsNullOrEmpty(DisplayMessage))
{
    <MudAlert Severity="@(IsError ? Severity.Error : Severity.Success)" Dense="true" Class="mb-4" role="alert">@DisplayMessage</MudAlert>
}

@code {
    /// <summary>Messages starting with this prefix are shown as errors.</summary>
    public const string ErrorPrefix = "Fehler: ";

    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;

    private bool IsError => DisplayMessage?.StartsWith(ErrorPrefix, StringComparison.Ordinal) == true;

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
