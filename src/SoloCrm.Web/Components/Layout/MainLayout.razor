@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject QuickAddService QuickAdd
@inject CommandPaletteService Palette
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject SoloCrm.Application.Abstractions.AppClock Clock

<MudThemeProvider @ref="_themeProvider" Theme="SoloCrmTheme.Instance" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Navigation ein-/ausblenden" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">SoloCRM</MudText>
        <MudSpacer />
        @* Looks like a search field and opens the command palette (SPEC 3.4). It opens on click or Enter, not on
           focus alone: tabbing through the app bar must not open a dialog (WCAG 3.2.1). *@
        <button type="button" class="app-search d-none d-sm-flex mx-4" aria-label="Suchen (Strg+K)" @onclick="Palette.OpenAsync">
            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
            <span class="app-search-text">Suchen…</span>
            <kbd>@ShortcutLabel</kbd>
        </button>
        <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Inherit" Class="d-flex d-sm-none"
                       aria-label="Suchen" OnClick="Palette.OpenAsync" />
        <MudTooltip Text="@($"{QuickAdd.CurrentLabel} (N)")">
            <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Inherit"
                           aria-label="@QuickAdd.CurrentLabel" OnClick="QuickAdd.OpenForCurrentPageAsync" />
        </MudTooltip>
        <MudToggleIconButton @bind-Toggled="_isDarkMode"
                             Icon="@Icons.Material.Filled.DarkMode" Color="Color.Inherit"
                             ToggledIcon="@Icons.Material.Filled.LightMode" ToggledColor="Color.Inherit"
                             aria-label="Hell-/Dunkelmodus umschalten" />
        <UserMenu />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1"
               Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
        <NavMenu />
        <div class="mt-auto pa-4">
            <MudLink Href="https://www.guido-altmann.de" Target="_blank" Typo="Typo.caption"
                     Color="Color.Default" Underline="Underline.Hover">© @Clock.Now.Year Guido Altmann</MudLink>
        </div>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MudThemeProvider? _themeProvider;
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private IJSObjectReference? _keyboard;
    private string ShortcutLabel => _isMac ? "⌘K" : "Strg K";
    private bool _isMac;
    private DotNetObjectReference<MainLayout>? _selfReference;

    // The quick-add button depends on the current page.
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        QuickAdd.TargetChanged += OnQuickAddTargetChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void OnQuickAddTargetChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (_themeProvider is not null)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }

        _selfReference = DotNetObjectReference.Create(this);
        _keyboard = await JS.InvokeAsync<IJSObjectReference>("import", "./js/keyboard.js");
        _isMac = await _keyboard.InvokeAsync<bool>("register", _selfReference);
        StateHasChanged();
    }

    /// <summary>Called by keyboard.js for global shortcuts (SPEC 3.2).</summary>
    [JSInvokable]
    public async Task OnShortcut(string shortcut)
    {
        if (KeyboardShortcuts.NavigationTarget(shortcut) is { } href)
        {
            Navigation.NavigateTo(href);
            return;
        }

        await (shortcut switch
        {
            "palette" => Palette.OpenAsync(),
            "n" => QuickAdd.OpenForCurrentPageAsync(),
            "?" => ShowShortcutsAsync(),
            _ => Task.CompletedTask,
        });
    }

    private Task ShowShortcutsAsync() => DialogService.ShowAsync<KeyboardShortcutsDialog>(
        "Tastenkürzel",
        new DialogParameters<KeyboardShortcutsDialog> { { d => d.IsMac, _isMac } },
        DialogDefaults.Small);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        QuickAdd.TargetChanged -= OnQuickAddTargetChanged;

        if (_keyboard is not null)
        {
            try
            {
                await _keyboard.InvokeVoidAsync("unregister");
                await _keyboard.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit is gone; the browser has already discarded the listener.
            }
        }

        _selfReference?.Dispose();
    }
}
