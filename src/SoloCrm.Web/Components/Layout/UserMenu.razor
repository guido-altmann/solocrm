@implements IDisposable
@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized>
        <MudMenu @ref="_menu" Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                 aria-label="Benutzermenü">
            <MudMenuItem Disabled="true">@context.User.Identity?.Name</MudMenuItem>
            <MudMenuItem AutoClose="false" OnClick="OpenAccountAsync" Icon="@Icons.Material.Filled.ManageAccounts"
                         data-testid="user-menu-account">Konto</MudMenuItem>
            <MudDivider />
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@_currentUrl" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Logout" Class="justify-start px-4">
                    Abmelden
                </MudButton>
            </form>
        </MudMenu>
    </Authorized>
    <NotAuthorized>
        <MudIconButton Href="Account/Login" Icon="@Icons.Material.Filled.Login" Color="Color.Inherit"
                       aria-label="Anmelden" />
    </NotAuthorized>
</AuthorizeView>

@code {
    private MudMenu? _menu;
    private string? _currentUrl;

    protected override void OnInitialized()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    /// <summary>
    /// Closes the menu while the circuit is still connected, then navigates with a full reload.
    /// A <c>Href</c> + <c>ForceLoad</c> menu item navigates first and closes afterwards, which fails
    /// with a JSDisconnectedException once the reload has dropped the circuit.
    /// </summary>
    private async Task OpenAccountAsync()
    {
        if (_menu is not null)
        {
            await _menu.CloseMenuAsync();
        }

        NavigationManager.NavigateTo("Account/Manage", forceLoad: true);
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
