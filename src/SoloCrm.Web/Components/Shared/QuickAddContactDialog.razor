@using SoloCrm.Application.Abstractions
@using SoloCrm.Application.Features.Contacts
@using SoloCrm.Domain.Contacts
@inject ICommandHandler<CreateContact.Command, CreateContact.Result> CreateContactHandler

<form @onsubmit="SaveAsync">
    <MudDialog>
        <DialogContent>
            <MudStack Spacing="2">
                <MudTextField @bind-Value="_firstName" Label="Vorname" Immediate="true" AutoFocus="true"
                              MaxLength="@Contact.FirstNameMaxLength"
                              Error="@_errors.Has(nameof(CreateContact.Command.FirstName))"
                              ErrorText="@_errors.Text(nameof(CreateContact.Command.FirstName))" />
                <MudTextField @bind-Value="_lastName" Label="Nachname" Immediate="true"
                              MaxLength="@Contact.LastNameMaxLength"
                              Error="@_errors.Has(nameof(CreateContact.Command.LastName))"
                              ErrorText="@_errors.Text(nameof(CreateContact.Command.LastName))" />
                <MudTextField @bind-Value="_email" Label="E-Mail" InputType="InputType.Email" Immediate="true"
                              MaxLength="@Contact.EmailMaxLength"
                              Error="@_errors.Has(nameof(CreateContact.Command.Email))"
                              ErrorText="@_errors.Text(nameof(CreateContact.Command.Email))" />
                @if (_errors.General is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_errors.General</MudAlert>
                }
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel" Disabled="_saving">Abbrechen</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving">
                Speichern
            </MudButton>
        </DialogActions>
    </MudDialog>
</form>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly FormErrors _errors = new();
    private string? _firstName;
    private string? _lastName;
    private string? _email;
    private bool _saving;

    private async Task SaveAsync()
    {
        _saving = true;
        _errors.Clear();

        try
        {
            var result = await CreateContactHandler.Handle(
                new CreateContact.Command(_firstName, _lastName, _email),
                CancellationToken.None);

            if (result.IsSuccess)
            {
                MudDialog.Close(DialogResult.Ok(result.Value.Id));
                return;
            }

            _errors.Show(result.Error, error =>
                error == CreateContact.Errors.DuplicateEmail ? nameof(CreateContact.Command.Email) : null);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
