@inject IJSRuntime JS
@inject ISnackbar Snackbar

@* Shows a webhook secret or an API key exactly once (US-17 AK1, US-18 AK1); only a hash or ciphertext is stored. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudAlert Severity="Severity.Warning" Dense="true">
                Dieser Wert wird nur jetzt angezeigt. Bitte sofort kopieren und sicher ablegen.
            </MudAlert>
            @if (Hint is not null)
            {
                <MudText Typo="Typo.body2">@Hint</MudText>
            }
            <MudTextField T="string" Value="@Secret" Label="@Label" ReadOnly="true" Variant="Variant.Outlined"
                          Class="secret-value font-monospace"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                          AdornmentAriaLabel="In die Zwischenablage kopieren" OnAdornmentClick="CopyAsync" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">Fertig</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Secret { get; set; } = "";

    [Parameter]
    public string Label { get; set; } = "Secret";

    [Parameter]
    public string? Hint { get; set; }

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Secret);
            Snackbar.Add("In die Zwischenablage kopiert.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Kopieren nicht möglich – bitte manuell markieren.", Severity.Warning);
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
