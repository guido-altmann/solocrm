<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage of the core (NFR: at least 80 % for Domain and Application, iteration 6 decision 9). -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*SoloCrm\.Domain\.dll$</ModulePath>
        <ModulePath>.*SoloCrm\.Application\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
